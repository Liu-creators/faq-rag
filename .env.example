# LLM（DeepSeek / OpenAI 兼容；改写 / 后续文档 RAG 共用）
# API Key：https://platform.deepseek.com/
LLM_API_KEY=sk-your-deepseek-key
# 可选；默认 https://api.deepseek.com
# Ollama 示例：http://localhost:11434/v1
LLM_BASE_URL=https://api.deepseek.com
# 可选；默认 deepseek-v4-flash（也可用 deepseek-v4-pro）
LLM_MODEL=deepseek-v4-flash

# MySQL（FAQ 业务数据持久化；docker compose 默认账号如下）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=faq
MYSQL_PASSWORD=faq
MYSQL_DATABASE=faq_rag
# 也可直接给完整 URL（优先于上面分项）：
# DATABASE_URL=mysql+pymysql://faq:faq@127.0.0.1:3306/faq_rag?charset=utf8mb4

# FAQ 检索：Milvus 混合检索（dense + BM25），默认开启
# 需先 docker compose up -d（完整 Milvus ≥2.5；Lite 不支持内置 BM25）
MILVUS_ENABLED=true
MILVUS_URI=http://localhost:19530
# MILVUS_TOKEN=root:Milvus
MILVUS_COLLECTION=faq_questions

# 稠密向量（二选一）：
# 1) 预训 Word2Vec KeyedVectors（.kv）— 推荐本地起步
WORD2VEC_MODEL_PATH=data/models/word2vec.kv
# 2) OpenAI 兼容 embeddings（如 Ollama）；设置后优先于 Word2Vec
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_API_KEY=ollama
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIM=768

# 关闭 Milvus 时：有 WORD2VEC_MODEL_PATH 则用内存 Word2Vec；否则 ExactContainment
# MILVUS_ENABLED=false
